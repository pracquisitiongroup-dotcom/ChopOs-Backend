/**
 * GET /api/opportunities
 * ------------------------------------------------------------------
 * Backs the Revenue page. Same pattern as /api/leads: requires a
 * logged-in user, pulls that business's GHL credentials from the
 * database, and returns opportunities in the canonical shape.
 *
 * Now also:
 *  - resolves real pipeline stage names (was previously just status)
 *  - computes "recommendations" — which stalled opportunities are
 *    most worth following up on, and why. This is plain arithmetic
 *    over real data (age + value), not an AI guess — no Anthropic
 *    credits needed, and every reason is honestly derived from
 *    numbers actually in the opportunity, not invented.
 * ------------------------------------------------------------------
 */

import type { VercelRequest, VercelResponse } from "@vercel/node";
import { fetchGhlOpportunities, fetchGhlPipelines, buildStageNameMap } from "../adapters/ghl";
import { getAuthedBusiness } from "../lib/auth";
import { supabase } from "../lib/supabase";

const STALLED_THRESHOLD_DAYS = 3;
const MAX_RECOMMENDATIONS = 5;

function buildRecommendations(opportunities: any[]) {
  const now = Date.now();

  const stalled = opportunities
    .filter((o) => o.status === "open")
    .map((o) => ({
      ...o,
      daysOld: Math.max(0, Math.floor((now - new Date(o.createdAt).getTime()) / 86400000)),
    }))
    .filter((o) => o.daysOld >= STALLED_THRESHOLD_DAYS)
    .sort((a, b) => b.value - a.value) // highest dollar value first — the honest priority signal we actually have
    .slice(0, MAX_RECOMMENDATIONS);

  return stalled.map((o, index) => ({
    id: o.id,
    leadId: o.leadId,
    name: o.name,
    value: o.value,
    daysOld: o.daysOld,
    reason:
      index === 0
        ? `Your highest-value stalled opportunity — $${o.value.toLocaleString()}, no movement in ${o.daysOld} day${o.daysOld === 1 ? "" : "s"}.`
        : `$${o.value.toLocaleString()}, stalled ${o.daysOld} day${o.daysOld === 1 ? "" : "s"} — worth a quick check-in.`,
  }));
}

export default async function handler(req: VercelRequest, res: VercelResponse) {
  const allowedOrigin = process.env.ALLOWED_ORIGIN || "*";
  res.setHeader("Access-Control-Allow-Origin", allowedOrigin);
  res.setHeader("Access-Control-Allow-Methods", "GET, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type, Authorization");
  if (req.method === "OPTIONS") return res.status(204).end();

  try {
    const auth = await getAuthedBusiness(req);
    if (!auth) return res.status(401).json({ error: "Not authenticated" });

    const { data: business, error: bizError } = await supabase
      .from("businesses")
      .select("ghl_private_token, ghl_location_id")
      .eq("id", auth.businessId)
      .single();

    if (bizError || !business?.ghl_private_token || !business?.ghl_location_id) {
      return res.status(500).json({
        error: "This business hasn't connected a CRM yet (missing GHL credentials).",
      });
    }

    const config = { privateToken: business.ghl_private_token, locationId: business.ghl_location_id };
    const opportunities = await fetchGhlOpportunities(config, { limit: 100 });

    // Resolve real stage names — best-effort. If this fails (e.g. the
    // param-name guess needs correcting, same situation as the
    // opportunities/search fix), fall back to showing status only
    // rather than breaking the whole page.
    let stageNameMap: Record<string, string> = {};
    try {
      const pipelines = await fetchGhlPipelines(config);
      stageNameMap = buildStageNameMap(pipelines);
    } catch (pipelineErr: any) {
      console.warn("[/api/opportunities] pipeline stage names unavailable:", pipelineErr.message);
    }

    const opportunitiesWithStageNames = opportunities.map((o: any) => ({
      ...o,
      stageName: stageNameMap[o.stage] || null, // null means "couldn't resolve" — frontend falls back to status
    }));

    const recommendations = buildRecommendations(opportunities);

    return res.status(200).json({ opportunities: opportunitiesWithStageNames, recommendations });
  } catch (err: any) {
    console.error("[/api/opportunities] error:", err);
    return res.status(500).json({ error: err.message || "Unknown error" });
  }
}
